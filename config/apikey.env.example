# ===================================================================
# 健康医疗 AI 智能平台 —— API Key 配置模板
# 使用方式：复制本文件为 config/apikey.env，并填入你自己的密钥。
#   cp config/apikey.env.example config/apikey.env
# 注意：config/apikey.env 已被 .gitignore 忽略，不会提交到仓库。
# ===================================================================

# ========== 全局配置 ==========
# 默认 LLM 提供商 (可选: qwen, baichuan, groq, openai, gemini, ollama, local)
LLM_PROVIDER=qwen
LLM_TEMPERATURE=0.1
AGENT_TIMEOUT=60
MAX_CONCURRENT_AGENTS=3

# ========== 1. 通义千问 (DashScope) ==========
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v1

# ========== 2. Groq (融合自 Project3-HealthInsights，OpenAI 兼容接口) ==========
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ========== 3. OpenAI ==========
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ========== 4. Google Gemini ==========
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest

# ========== 5. 百川智能 (Baichuan) ==========
BAICHUAN_API_KEY=
BAICHUAN_MODEL=Baichuan-M2

# ========== 6. Ollama (本地服务) ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ========== 7. 本地模型 (HuggingFace 原生加载) ==========
LOCAL_MODEL_PATH=
LOCAL_EMBEDDING_MODEL=

# ========== 知识库 (RAG) 配置 ==========
ENABLE_RAG=true
USE_LOCAL_RAG=false

# Pinecone (云端向量库)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medical-diagnostics
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# Neo4j (知识图谱，可选)
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
